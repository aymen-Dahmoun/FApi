from fastapi import APIRouter, Depends
from app.schemas.auth import LoginRequest, Token
from app.schemas.user import UserCreate, UserResponse
from app.dependencies.auth import get_current_user
from app.models.user import User

{% if db_choice == "mongodb" %}
from app.services.auth import register as auth_register, login as auth_login

router = APIRouter()

@router.post("/register", response_model=Token)
async def register(user_in: UserCreate):
    return await auth_register(user_in)

@router.post("/login", response_model=Token)
async def login(login_in: LoginRequest):
    return await auth_login(login_in)

@router.get("/me", response_model=UserResponse)
async def me(current_user: User = Depends(get_current_user)):
    return current_user

{% elif is_async %}
from sqlalchemy.ext.asyncio import AsyncSession
from app.core.database import get_db
from app.services.auth import register as auth_register, login as auth_login

router = APIRouter()

@router.post("/register", response_model=Token)
async def register(user_in: UserCreate, db: AsyncSession = Depends(get_db)):
    return await auth_register(db, user_in)

@router.post("/login", response_model=Token)
async def login(login_in: LoginRequest, db: AsyncSession = Depends(get_db)):
    return await auth_login(db, login_in)

@router.get("/me", response_model=UserResponse)
async def me(current_user: User = Depends(get_current_user)):
    return current_user

{% else %}
from sqlalchemy.orm import Session
from app.core.database import get_db
from app.services.auth import register as auth_register, login as auth_login

router = APIRouter()

@router.post("/register", response_model=Token)
def register(user_in: UserCreate, db: Session = Depends(get_db)):
    return auth_register(db, user_in)

@router.post("/login", response_model=Token)
def login(login_in: LoginRequest, db: Session = Depends(get_db)):
    return auth_login(db, login_in)

@router.get("/me", response_model=UserResponse)
def me(current_user: User = Depends(get_current_user)):
    return current_user
{% endif %}
