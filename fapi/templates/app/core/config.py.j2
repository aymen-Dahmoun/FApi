import os
from pydantic_settings import BaseSettings
from dotenv import load_dotenv

load_dotenv()

class Settings(BaseSettings):
    APP_NAME: str = "{{ project_name }}"
{% if use_db %}
    DATABASE_URL: str = os.getenv("DATABASE_URL", "{{ 'postgresql+asyncpg://user:pass@localhost/db' if db_choice == 'postgres' and is_async else 'postgresql://user:pass@localhost/db' if db_choice == 'postgres' else 'mongodb://localhost:27017' if db_choice == 'mongodb' else 'sqlite:///./app.db' }}")
{% endif %}
{% if redis %}
    REDIS_URL: str = os.getenv("REDIS_URL", "redis://localhost:6379/0")
{% endif %}
{% if auth %}
    SECRET_KEY: str = os.getenv("SECRET_KEY", "supersecretkey")
    ALGORITHM: str = "HS256"
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 30
{% endif %}
{% if mail %}
    MAIL_USERNAME: str = os.getenv("MAIL_USERNAME", "user@example.com")
    MAIL_PASSWORD: str = os.getenv("MAIL_PASSWORD", "strong_password")
    MAIL_FROM: str = os.getenv("MAIL_FROM", "info@example.com")
    MAIL_PORT: int = 587
    MAIL_SERVER: str = os.getenv("MAIL_SERVER", "smtp.example.com")
{% endif %}

    class Config:
        env_file = ".env"
        extra = "allow"

settings = Settings()

# Explicitly export mapped settings for cleaner imports
APP_NAME = settings.APP_NAME
{% if use_db %}
DATABASE_URL = settings.DATABASE_URL
{% endif %}
{% if redis %}
REDIS_URL = settings.REDIS_URL
{% endif %}
{% if auth %}
SECRET_KEY = settings.SECRET_KEY
ALGORITHM = settings.ALGORITHM
ACCESS_TOKEN_EXPIRE_MINUTES = settings.ACCESS_TOKEN_EXPIRE_MINUTES
{% endif %}
{% if mail %}
MAIL_USERNAME = settings.MAIL_USERNAME
MAIL_PASSWORD = settings.MAIL_PASSWORD
MAIL_FROM = settings.MAIL_FROM
MAIL_PORT = settings.MAIL_PORT
MAIL_SERVER = settings.MAIL_SERVER
{% endif %}
