{% if db_choice == "mongodb" %}
from app.models.user import User
from app.schemas.user import UserCreate, UserResponse
{% if auth %}
async def create_user(user: UserCreate, hashed_password: str):
    db_user = User(email=user.email, hashed_password=hashed_password)
    await db_user.insert()
    return {
        "id": str(db_user.id),
        "email": db_user.email,
    }
{% else %}
import bcrypt
async def create_user(user: UserCreate):
    salt = bcrypt.gensalt()
    hashed = bcrypt.hashpw(user.password.encode('utf-8'), salt).decode('utf-8')
    db_user = User(email=user.email, hashed_password=hashed)
    await db_user.insert()
    return db_user
{% endif %}

async def get_user_by_email(email: str):
    return await User.find_one(User.email == email)

async def get_user_by_id(user_id: str):
    from beanie import PydanticObjectId
    try:
        obj_id = PydanticObjectId(user_id)
    except Exception:
        return None
    return await User.find_one(User.id == obj_id)

async def get_user(user_id: str):
    return await get_user_by_id(user_id)

async def list_users():
    return await User.find_all().to_list()

async def get_users():
    users = await User.find_all().to_list()
    return [
        UserResponse(
            id=str(user.id),
            email=user.email,
        )
        for user in users
    ]
async def delete_user(user_id: str):
    user = await get_user_by_id(user_id)
    if user:
        await user.delete()
        return True
    return False

async def update_user(user_id: str, update_data: dict):
    user = await get_user_by_id(user_id)
    if user:
        for key, value in update_data.items():
            setattr(user, key, value)
        await user.save()
        return user
    return None

{% elif is_async %}
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy import select
from app.models.user import User
from app.schemas.user import UserCreate

{% if auth %}
async def create_user(db: AsyncSession, user: UserCreate, hashed_password: str):
    db_user = User(email=user.email, hashed_password=hashed_password)
    db.add(db_user)
    await db.commit()
    await db.refresh(db_user)
    return db_user
{% else %}
import bcrypt
async def create_user(db: AsyncSession, user: UserCreate):
    salt = bcrypt.gensalt()
    hashed = bcrypt.hashpw(user.password.encode('utf-8'), salt).decode('utf-8')
    db_user = User(email=user.email, hashed_password=hashed)
    db.add(db_user)
    await db.commit()
    await db.refresh(db_user)
    return db_user
{% endif %}

async def get_user_by_email(db: AsyncSession, email: str):
    result = await db.execute(select(User).where(User.email == email))
    return result.scalars().first()

async def get_user_by_id(db: AsyncSession, user_id: int):
    result = await db.execute(select(User).where(User.id == user_id))
    return result.scalars().first()

async def get_user(db: AsyncSession, user_id: int):
    return await get_user_by_id(db, user_id)

async def list_users(db: AsyncSession):
    result = await db.execute(select(User))
    return result.scalars().all()

async def get_users(db: AsyncSession):
    return await list_users(db)

async def delete_user(db: AsyncSession, user_id: int):
    user = await get_user_by_id(db, user_id)
    if user:
        await db.delete(user)
        await db.commit()
        return True
    return False

async def update_user(db: AsyncSession, user_id: int, update_data: dict):
    user = await get_user_by_id(db, user_id)
    if user:
        for key, value in update_data.items():
            setattr(user, key, value)
        db.add(user)
        await db.commit()
        await db.refresh(user)
        return user
    return None

{% else %}
from sqlalchemy.orm import Session
from app.models.user import User
from app.schemas.user import UserCreate

{% if auth %}
def create_user(db: Session, user: UserCreate, hashed_password: str):
    db_user = User(email=user.email, hashed_password=hashed_password)
    db.add(db_user)
    db.commit()
    db.refresh(db_user)
    return db_user
{% else %}
import bcrypt
def create_user(db: Session, user: UserCreate):
    salt = bcrypt.gensalt()
    hashed = bcrypt.hashpw(user.password.encode('utf-8'), salt).decode('utf-8')
    db_user = User(email=user.email, hashed_password=hashed)
    db.add(db_user)
    db.commit()
    db.refresh(db_user)
    return db_user
{% endif %}

def get_user_by_email(db: Session, email: str):
    return db.query(User).filter(User.email == email).first()

def get_user_by_id(db: Session, user_id: int):
    return db.query(User).filter(User.id == user_id).first()

def get_user(db: Session, user_id: int):
    return get_user_by_id(db, user_id)

def list_users(db: Session):
    return db.query(User).all()

def get_users(db: Session):
    return list_users(db)

def delete_user(db: Session, user_id: int):
    user = get_user_by_id(db, user_id)
    if user:
        db.delete(user)
        db.commit()
        return True
    return False

def update_user(db: Session, user_id: int, update_data: dict):
    user = get_user_by_id(db, user_id)
    if user:
        for key, value in update_data.items():
            setattr(user, key, value)
        db.add(user)
        db.commit()
        db.refresh(user)
        return user
    return None
{% endif %}
